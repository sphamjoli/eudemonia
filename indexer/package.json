{
  "name": "eudemonia-indexer",
  "private": true,
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "envio start",
    "benchmark": "envio benchmark",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "test:worker": "tsx --test src/worker/**/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"watch.ts\"",
    "format": "prettier --check \"src/**/*.ts\" \"*.{json,yaml,yml,md,ts}\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"*.{json,yaml,yml,md,ts}\""
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ioredis": "^5.4.1",
    "ora": "^8.1.1",
    "viem": "^2.17.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "envio": "^2.14.4",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.16.2",
    "typescript": "^5.6.3"
  }
}
