ADI_RPC_URL=https://rpc.ab.testnet.adifoundation.ai/
CHAIN_ID=99999
ISSUANCE_REGISTRY=
PAYMENT_REGISTRY=
POLICY_REGISTRY=
TOKENISATION_ENGINE=
RWA_TOKEN=
CONFIDENTIAL_SETTLEMENT=
PRIVATE_KEY=

# Envio runtime
ENVIO_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/envio
INDEXER_GRAPHQL_URL=http://127.0.0.1:8081/v1/graphql
INDEXER_JOB_BATCH_SIZE=10

# Redis-backed worker state
REDIS_URL=redis://redis:6379
WORKER_INSTANCE_ID=worker-1
WORKER_POLL_INTERVAL_MS=5000
PROOF_LOCK_TTL_MS=120000
PROOF_MAX_RETRIES=5
PROOF_BACKOFF_BASE_MS=5000
PROOF_BACKOFF_MAX_MS=300000
WORKER_API_ENABLED=true
WORKER_API_PORT=8787

# SP1 prover integration
SP1_PROVER_CMD="cargo run --manifest-path ../crates/prover/Cargo.toml --"
SP1_PROVE_COMMAND="succinct prove {program_id} {witness} {proof}"
SP1_VERIFY_COMMAND="succinct verify {program_id} {proof}"
SP1_PROGRAM_ID=payroll_checker
SP1_PROGRAM_VKEY=
SP1_MOCK_MODE=true
